{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portside",
  "version": "0.1.0",
  "identifier": "com.ahmedtrooper.portside",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Portside",
        "width": 750,
        "height": 500,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "minWidth": 200,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
